        {
          "type": "system",
          "severity": "info",
          "text": {
            "tr": "08:14 · uydu rölesi 2.840m · -13°C · açık sivil hat",
            "en": "08:14 · sat relay 2,840m · -13°C · open civil bridge"
          }
        },
        {
          "type": "message",
          "text": {
            "tr": "Lütfen bu mesajı kapatma. Ben Emre—Kuzey Sırtı meteoroloji sensörünün pilini değiştirmek için 2.840 metreye çıkmış bir saha teknisyeniyim.",
            "en": "Please don't swipe this away. My name is Ethan—field tech up at 2,840 meters on North Ridge servicing a weather sensor."
          }
        },
        {
          "type": "message",
          "text": {
            "tr": "Erken bastıran tipide buzlu çarşaktan kaydım. Telefonumun ekranı soğukta paramparça oldu; elimdeki tek şey şu beyaz yedek uydu aktarıcısı.",
            "en": "Slipped on loose scree when an early whiteout hit. My phone shattered in the cold—all I've got left is this white pocket satellite texter."
          }
        },
        {
          "type": "message",
          "text": {
            "tr": "Ve harika haber: geçen hafta bakım yaparken acil röle kodunu yanlış girmişler. S.O.S. sinyali kurtarma merkezi yerine rastgele senin telefonuna düştü!",
            "en": "And great news: whoever serviced the relay last week mistyped the bridge digit. Instead of Mountain Rescue, my SOS dropped onto your phone!"
          }
        }
      ],
      "transition": {
        "type": "choice",
        "choiceKind": "standard",
        "options": [
          {
            "id": "opt_check_injury",
            "label": {
              "tr": "Durumun nasıl, yaralı mısın?",
              "en": "Wait—are you hurt?"
            },
            "target": "act1_check_injury"
          },
          {
            "id": "opt_wrong_number",
            "label": {
              "tr": "Şaka mı bu? 112'yi arasana!",
              "en": "Is this a prank? Call 911!"
            },
            "effects": [
              {
                "var": "skeptic_start",
                "op": "set",
                "value": true
              }
            ],
            "target": "act1_wrong_number"
          }
        ]
      }
    },
