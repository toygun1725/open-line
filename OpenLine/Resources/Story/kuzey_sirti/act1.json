      "act": 1,
      "items": [
        {
          "type": "message",
          "text": {
            "tr": "Akıllıca—çay hâlâ sıcak sayılır! İki yudum aldım, eldivenimin içine kimyasal ısıtıcıyı attım. Rüzgar siperine tırmanıyorum.",
            "en": "Smart pick—tea's still warm enough to sting! Took a sip and shoved a hand warmer inside my glove. Climbing onto the windbreak ledge."
          }
        }
      ],
      "transition": {
        "type": "next",
        "target": "act1_pack_banter"
      }
    },
    {
      "id": "act1_got_battery",
      "act": 1,
      "items": [
        {
          "type": "message",
          "text": {
            "tr": "Soğukta lityum piller yarı yarıya ölür, bunu yanıma almam hayat kurtaracak. Rüzgar iyice sertleşti, taş çıkıntının altına tırmanıyorum.",
            "en": "Good call—freezing air cuts battery capacity in half. Wind's howling now, scrambling up beneath a rock overhang."
          }
        }
      ],
      "transition": {
        "type": "next",
        "target": "act1_pack_banter"
      }
    },
